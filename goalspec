#!/usr/bin/env bash
# goalspec — main dispatch entry.
set -uo pipefail

# Where is this script? (.goalspec/goalspec itself). The framework runtime sits next to it.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

GOALSPEC_BIN_DIR="$SCRIPT_DIR/runtime/commands"

goalspec_help() {
  cat <<'EOF'
goalspec — goal-driven spec framework

Three core actions:
  start <intent>   begin defining a change
  run              begin implementation; generate a close package when Criteria pass
  close            close out: apply memory, archive, commit, push, open a PR

Only state "closed" allows the next "start".

Usage:
  goalspec <command> [args]

Commands:
  init [project-path]           Initialize .goalspec/ in current git repo
                                (or into <project-path> if given)
  install [project-path]        Alias for init — install into an explicit
                                project directory (no cd needed)
  install-skill [dest-dir]      Install bundled Goalspec AI skill
  install-ai <tool>             Install AI tool adapter (codex|claude|lingma)
  status [--json]               Show current goal-driven state
  start <intent>                Start the formal intake window (only from
                                no_goal or closed)
  source <path>                 Add a file or directory source to intake
  end                           Close the formal intake window
  run                           Begin implementation from the frozen
                                Goal-Driven Prompt; generate a close package
                                when all required Criteria pass
  close                         Confirm the close package, apply memory, archive
                                history, commit, push, and open a PR (-> closed)
  reopen [reason]               Reopen when frozen artifacts are wrong
  scope amend --allow <glob> --reason <text>
                                Human-approved expansion of the current
                                allowed scope without changing Criteria

Internal commands:
  intake begin [text]           Internal alias for start
  intake add-source <path>      Internal alias for source
  intake end                    Internal alias for end
  intake apply-suggestions      Apply approved intake constraint suggestions
  new-goal [--source <path>] [text]
                                Create a new active goal and optional source
  review prompt [kind]          Print a fresh-context review prompt
                                (kind: intake|contract|criteria)
  review apply <file>           Apply a review result YAML
  compile                       Compile goal.md -> draft contract.yaml
  approve <kind> [id]           Record human approval (kind: goal|contract|
                                memory-patch|intake-package|intake-capture|
                                high-risk|regression-waiver)
  freeze                        Freeze reviewed artifacts and generate prompt
  evidence template [criteria_id]  Print an evidence template
  evidence check                   Validate evidence.yaml
  judge prompt [criteria_id]       Print a Master verdict prompt
  judge apply <verdict.yaml>       Apply a Master verdict file
  scope-check [--suggest]       Check that diffs are within scope
  validate [target] [--strict] [--json]
                                Validate active/ artifacts (collect-all, no
                                fail-fast). target: goal|contract|evidence|
                                verdict|state|intake|all (default all)
  complete                      Legacy internal alias for close readiness gate
  yq which|install              Manage the bundled yq dependency
                                (which: show resolved binary; install: fetch a
                                matching mikefarah yq v4 into runtime/bin/)
  version                       Show version

Environment:
  Must be inside a project initialized by `goalspec init` (except for `init`
  and `version`).
EOF
}

if [ $# -lt 1 ]; then
  goalspec_help
  exit 0
fi

cmd="$1"; shift || true

# Commands that do not require an initialized project.
case "$cmd" in
  help|--help|-h)
    goalspec_help
    exit 0
    ;;
  version|--version|-V)
    if [ -f "$SCRIPT_DIR/runtime/VERSION" ]; then
      cat "$SCRIPT_DIR/runtime/VERSION"
    else
      echo "goalspec v1"
    fi
    exit 0
    ;;
  init|install)
    # `install <path>` is an alias for `init <path>`: copy the framework into an
    # explicit project directory (default: current dir), no cd required.
    exec bash "$GOALSPEC_BIN_DIR/init.sh" "$@"
    ;;
  install-skill)
    exec bash "$GOALSPEC_BIN_DIR/install_skill.sh" "$@"
    ;;
  install-ai)
    exec bash "$GOALSPEC_BIN_DIR/install_ai.sh" "$@"
    ;;
  yq)
    # Handled in the pre-init block on purpose: `yq install` must be runnable
    # when NO yq is available yet (load.sh's yq gate would otherwise exit 1).
    exec bash "$GOALSPEC_BIN_DIR/yq_cmd.sh" "$@"
    ;;
esac

# All other commands require an initialized project.
if [ ! -d "$SCRIPT_DIR/runtime" ] || [ ! -f "$SCRIPT_DIR/runtime/lib/common.sh" ]; then
  echo "goalspec: runtime missing. Re-run 'goalspec init' from a clean copy." >&2
  exit 2
fi

GOALSPEC_ROOT="$SCRIPT_DIR"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
# Use the invoked project-local .goalspec/goalspec as the sole root. Silently
# switching to $PWD/.goalspec can mix runtime from one project with state from
# another when an absolute goalspec path is invoked from a different repo.
if [ -d "$PWD/.goalspec" ] && [ "$(cd "$PWD/.goalspec" && pwd)" != "$SCRIPT_DIR" ]; then
  echo "goalspec: ignoring different .goalspec in current directory; using invoked root $SCRIPT_DIR" >&2
fi
export GOALSPEC_ROOT PROJECT_ROOT

case "$cmd" in
  status)            exec bash "$GOALSPEC_BIN_DIR/status.sh" "$@" ;;
  start)             exec bash "$GOALSPEC_BIN_DIR/intake.sh" begin "$@" ;;
  source)            exec bash "$GOALSPEC_BIN_DIR/intake.sh" add-source "$@" ;;
  end)               exec bash "$GOALSPEC_BIN_DIR/intake.sh" end "$@" ;;
  run)               exec bash "$GOALSPEC_BIN_DIR/run.sh" "$@" ;;
  close)             exec bash "$GOALSPEC_BIN_DIR/close.sh" "$@" ;;
  intake)            exec bash "$GOALSPEC_BIN_DIR/intake.sh" "$@" ;;
  new-goal)          exec bash "$GOALSPEC_BIN_DIR/new_goal.sh" "$@" ;;
  review)            exec bash "$GOALSPEC_BIN_DIR/review.sh" "$@" ;;
  compile)           exec bash "$GOALSPEC_BIN_DIR/compile.sh" "$@" ;;
  approve)           exec bash "$GOALSPEC_BIN_DIR/approve.sh" "$@" ;;
  freeze)            exec bash "$GOALSPEC_BIN_DIR/freeze.sh" "$@" ;;
  evidence)          exec bash "$GOALSPEC_BIN_DIR/evidence.sh" "$@" ;;
  judge)             exec bash "$GOALSPEC_BIN_DIR/judge.sh" "$@" ;;
  scope-check)       exec bash "$GOALSPEC_BIN_DIR/scope_check.sh" "$@" ;;
  scope)             exec bash "$GOALSPEC_BIN_DIR/scope.sh" "$@" ;;
  validate)          exec bash "$GOALSPEC_BIN_DIR/validate.sh" "$@" ;;
  complete)          exec bash "$GOALSPEC_BIN_DIR/complete.sh" "$@" ;;
  reopen)            exec bash "$GOALSPEC_BIN_DIR/reopen.sh" "$@" ;;
  *)
    echo "goalspec: unknown command '$cmd' (see 'goalspec help')" >&2
    exit 2
    ;;
esac
